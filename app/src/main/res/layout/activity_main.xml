<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <View
        android:id="@+id/startupBlur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="visible" />

    <View
        android:id="@+id/flashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:alpha="0"
        android:visibility="gone" />

    <View
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/focus_ring"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/glass_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView android:id="@+id/btnLive" style="@style/TopBtn" android:text="LIVE" />
        <TextView android:id="@+id/btnFilter" style="@style/TopBtn" android:text="FILTER" />
        <TextView android:id="@+id/btnHd" style="@style/TopBtn" android:text="HD" />
        <TextView android:id="@+id/btnLock" style="@style/TopBtn" android:text="LOCK" />
    </LinearLayout>

    <TextView
        android:id="@+id/lockBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@drawable/glass_pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Camera Lock"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/zoomCapsule"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="210dp"
        android:background="@drawable/glass_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView android:id="@+id/zoom1" style="@style/ZoomBtn" android:text="1x" />
        <TextView android:id="@+id/zoom2" style="@style/ZoomBtn" android:text="2x" />
        <TextView android:id="@+id/zoom5" style="@style/ZoomBtn" android:text="5x" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/zoomSeek"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="180dp"
        android:max="490"
        android:progress="0"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_gravity="bottom"
        android:background="@drawable/glass_bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/modeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHOTO"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnGallery"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/glass_circle"
                android:scaleType="centerCrop"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_gallery" />

            <FrameLayout
                android:id="@+id/shutter"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginHorizontal="36dp"
                android:background="@drawable/shutter_outer">
                <View
                    android:id="@+id/shutterInner"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter_inner" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnFlip"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/glass_circle"
                android:gravity="center"
                android:text="↻"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnArrow"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="⌃"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/glass_sheet"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView android:id="@+id/drawerTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Меню" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <TextView android:id="@+id/menuLive" style="@style/MenuBtn" android:text="Live" />
            <TextView android:id="@+id/menuFilter" style="@style/MenuBtn" android:text="Фильтры" />
            <TextView android:id="@+id/menuSettings" style="@style/MenuBtn" android:text="Настройки" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <TextView android:id="@+id/ratio916" style="@style/MenuBtn" android:text="9:16" />
            <TextView android:id="@+id/ratio43" style="@style/MenuBtn" android:text="4:3" />
            <TextView android:id="@+id/ratio11" style="@style/MenuBtn" android:text="1:1" />
        </LinearLayout>
        <TextView android:id="@+id/menuQuality" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/glass_pill" android:paddingHorizontal="14dp" android:paddingVertical="8dp" android:text="Качество" android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/qualitySheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/glass_sheet"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Качество" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/q4k" style="@style/QualityRow" android:text="4K" />
        <TextView android:id="@+id/q2k" style="@style/QualityRow" android:text="2K" />
        <TextView android:id="@+id/qfhd" style="@style/QualityRow" android:text="Full HD" />
        <TextView android:id="@+id/qhd" style="@style/QualityRow" android:text="HD / 720p" />
        <TextView android:id="@+id/q480" style="@style/QualityRow" android:text="480p" />
        <TextView android:id="@+id/q360" style="@style/QualityRow" android:text="360p" />
    </LinearLayout>

</FrameLayout>
